#!/usr/bin/env python3
import os
import sys
import subprocess
import base64

def main():
    slicer_test_script = """
import sys
import traceback
import slicer
import vtk

exit_code = 1
print()
print('=' * 70, flush=True)
print('RUNNING TESTS', flush=True)
print('=' * 70, flush=True)
print()

try:
    tests = slicer.util.getModuleLogic('ROS2Tests')
    tests.run()
    print()
    print('=' * 70, flush=True)
    print('ALL TESTS PASSED', flush=True)
    print('=' * 70, flush=True)
    print()
    exit_code = 0
except Exception as e:
    print()
    print('=' * 70, flush=True)
    print('TEST EXECUTION FAILED', flush=True)
    print('=' * 70, flush=True)
    print(type(e).__name__ + ': ' + str(e), flush=True)
    traceback.print_exc()
finally:
    vtk.vtkDebugLeaks.SetExitError(False)
    slicer.app.quit()
    sys.exit(exit_code)
"""
    encoded_script = base64.b64encode(slicer_test_script.encode('utf-8')).decode('ascii')
    slicer_test_code = f"import base64; exec(base64.b64decode('{encoded_script}').decode('utf-8'))"

    script_dir = os.path.dirname(os.path.realpath(__file__))
    launch_script = os.path.join(script_dir, '..', 'launch_slicer.sh')

    cmd = [
        launch_script,
        "--testing",
        "--no-main-window",
        "--python-code", slicer_test_code,
    ]

    try:
        res = subprocess.run(cmd)
        sys.exit(res.returncode)
    except KeyboardInterrupt:
        sys.exit(1)

if __name__ == '__main__':
    main()
