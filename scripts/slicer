#!/usr/bin/env python3
import os
import sys
import argparse
import subprocess
import shlex

def main():
    parser = argparse.ArgumentParser(
        description='Launch 3D Slicer with slicer_ros2_module.',
        add_help=True,
    )
    parser.add_argument(
        '--python-script', '-p',
        metavar='FILE',
        help='Python script to execute inside Slicer after startup '
             '(passed to Slicer as --python-script <FILE>).',
    )
    args, extra = parser.parse_known_args()
    if args.python_script:
        extra = ['--python-script', args.python_script] + extra

    # Preserve the installed path when colcon uses --symlink-install.
    script_dir = os.path.dirname(os.path.abspath(__file__))
    launch_script = os.path.join(script_dir, '..', 'launch_slicer.sh')

    if os.path.isfile(launch_script):
        # Standalone builds run directly from the source tree.
        cmd = [launch_script] + extra
    else:
        # Colcon installs the ROS launch file, not the standalone shell script.
        # Quote each argument so the launch file's shlex.split preserves Python
        # code, filenames with spaces, and other compound arguments.
        cmd = ['ros2', 'launch', 'slicer_ros2_module', 'slicer.launch.py']
        if extra:
            cmd.append('slicer_args:=' + shlex.join(extra))
    try:
        res = subprocess.run(cmd)
        sys.exit(res.returncode)
    except KeyboardInterrupt:
        sys.exit(1)

if __name__ == '__main__':
    main()
