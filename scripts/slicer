#!/usr/bin/env python3
import sys
import argparse
import subprocess

def main():
    parser = argparse.ArgumentParser(
        description='Launch 3D Slicer via the slicer_ros2_module ROS 2 launcher.',
        add_help=True,
    )
    parser.add_argument(
        '--python-script', '-p',
        metavar='FILE',
        action='append',
        dest='python_scripts',
        default=[],
        help='Python script to execute inside Slicer after startup. '
             'May be repeated to execute multiple scripts in order. '
             'A single script uses Slicer\'s --python-script flag; '
             'multiple scripts are chained via --python-code.',
    )
    # Collect any remaining args that should be forwarded to Slicer
    parser.add_argument('slicer_args', nargs='*', help='Extra arguments forwarded to Slicer')

    args = parser.parse_args()

    # Build the extra Slicer arguments list
    extra = list(args.slicer_args)

    scripts = args.python_scripts
    if len(scripts) == 1:
        # Single script: use the native --python-script flag
        extra = ['--python-script', scripts[0]] + extra
    elif len(scripts) > 1:
        # Multiple scripts: chain them with --python-code using exec()
        # Each file is executed in order in the same interpreter session.
        chain = '; '.join(
            f"exec(open('{f}').read())" for f in scripts
        )
        extra = ['--python-code', chain] + extra

    cmd = ['ros2', 'launch', 'slicer_ros2_module', 'slicer.launch.py']
    if extra:
        args_str = ' '.join(extra)
        cmd.append(f'slicer_args:={args_str}')

    try:
        subprocess.run(cmd)
    except KeyboardInterrupt:
        pass

if __name__ == '__main__':
    main()
