#!/usr/bin/env python3
import os
import sys
import argparse
import subprocess

def main():
    parser = argparse.ArgumentParser(
        description='Launch 3D Slicer with slicer_ros2_module.',
        add_help=True,
    )
    parser.add_argument(
        '--python-script', '-p',
        metavar='FILE',
        help='Python script to execute inside Slicer after startup '
             '(passed to Slicer as --python-script <FILE>).',
    )
    args, extra = parser.parse_known_args()
    if args.python_script:
        extra = ['--python-script', args.python_script] + extra

    script_dir = os.path.dirname(os.path.realpath(__file__))
    launch_script = os.path.join(script_dir, '..', 'launch_slicer.sh')

    cmd = [launch_script] + extra
    try:
        res = subprocess.run(cmd)
        sys.exit(res.returncode)
    except KeyboardInterrupt:
        sys.exit(1)

if __name__ == '__main__':
    main()
