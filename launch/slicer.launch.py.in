import os
import json
import shlex
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, ExecuteProcess, OpaqueFunction
from launch.substitutions import LaunchConfiguration

def append_existing_path(paths, path):
    if path and os.path.isdir(path) and path not in paths:
        paths.append(path)

def append_runtime_registry_paths(module_paths, library_paths, registry_path):
    if not os.path.exists(registry_path):
        return
    try:
        with open(registry_path) as f:
            registry = json.load(f)
    except Exception as e:
        print(f"Failed to read extension runtime paths from {registry_path}: {e}")
        return

    for extension_name, entry in registry.items():
        for path in entry.get("load_paths", []):
            append_existing_path(module_paths, path)
        for path in entry.get("library_paths", []):
            append_existing_path(library_paths, path)

def launch_setup(context, *args, **kwargs):
    # The Slicer executable path is substituted by CMake during configuration.
    slicer_executable = "@Slicer_DIR@/Slicer"

    # Module paths are baked in at build time by CMake configure_file. The
    # package prefix contains this module. Third-party extension build-tree
    # paths are read from the runtime registry below.
    install_prefixes = [
        "@CMAKE_INSTALL_PREFIX@",
    ]
    runtime_registry_path = os.path.join(
        "@CMAKE_INSTALL_PREFIX@",
        "@SlicerROS2_EXTENSIONS_CONFIG_DIR@",
        "runtime_paths.json",
    )
    all_paths_rel = ["@Slicer_INSTALL_BIN_DIR@",
                     "@Slicer_INSTALL_LIB_DIR@",
                     "@Slicer_INSTALL_QTLOADABLEMODULES_BIN_DIR@",
                     "@Slicer_INSTALL_QTLOADABLEMODULES_LIB_DIR@",
                     "@Slicer_INSTALL_QTLOADABLEMODULES_PYTHON_LIB_DIR@",
                     "@Slicer_INSTALL_QTLOADABLEMODULES_SHARE_DIR@",
                     "@Slicer_INSTALL_QTSCRIPTEDMODULES_BIN_DIR@",
                     "@Slicer_INSTALL_QTSCRIPTEDMODULES_LIB_DIR@",
                     "@Slicer_INSTALL_QTSCRIPTEDMODULES_PYTHON_LIB_DIR@",
                     "@Slicer_INSTALL_QTSCRIPTEDMODULES_SHARE_DIR@"]

    # Strip leading "./" so os.path.join works correctly
    module_paths = []
    library_paths = []
    
    # Check for SLICER_ROS2_MODULE_PATHS set by the environment hook (setup.bash)
    env_module_paths = os.environ.get('SLICER_ROS2_MODULE_PATHS', '')
    if env_module_paths:
        for p in env_module_paths.split(':'):
            append_existing_path(module_paths, p)

    for install_prefix in install_prefixes:
        for rel in all_paths_rel:
            rel = rel.lstrip("./")
            if rel:
                append_existing_path(module_paths, os.path.join(install_prefix, rel))

    append_runtime_registry_paths(module_paths, library_paths, runtime_registry_path)

    current_ld_library_path = os.environ.get('LD_LIBRARY_PATH', '')
    custom_paths = module_paths + [p for p in library_paths if p not in module_paths]
    custom_paths_str = ":".join(custom_paths) + ":@Slicer_DIR@/bin"

    if current_ld_library_path:
        new_ld_library_path = f"{custom_paths_str}:{current_ld_library_path}"
    else:
        new_ld_library_path = custom_paths_str

    # Build the base command
    cmd = [slicer_executable]
    cmd.extend(["--additional-module-paths"])
    cmd.extend(module_paths)

    # Safely perform and split the launch argument configuration string
    slicer_args_str = LaunchConfiguration('slicer_args').perform(context)
    if slicer_args_str:
        extra_args = shlex.split(slicer_args_str)
        cmd.extend(extra_args)

    process = ExecuteProcess(
        cmd=cmd,
        additional_env={
            'LD_LIBRARY_PATH': new_ld_library_path
        },
        shell=False,
        output='screen'
    )
    return [process]

def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument(
            'slicer_args',
            default_value='',
            description='Additional arguments to pass to Slicer'
        ),
        OpaqueFunction(function=launch_setup)
    ])

