import os
import shlex
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, ExecuteProcess
from launch.substitutions import LaunchConfiguration

def generate_launch_description():
    slicer_args = LaunchConfiguration('slicer_args')

    # The Slicer executable path is substituted by CMake during configuration.
    slicer_executable = "@Slicer_DIR@/Slicer"

    # Module paths are baked in at build time by CMake configure_file.
    install_prefix = "@CMAKE_INSTALL_PREFIX@"
    all_paths_rel = ["@Slicer_INSTALL_LIB_DIR@",
                     "@Slicer_INSTALL_QTLOADABLEMODULES_LIB_DIR@",
                     "@Slicer_INSTALL_QTLOADABLEMODULES_PYTHON_LIB_DIR@",
                     "@Slicer_INSTALL_QTLOADABLEMODULES_SHARE_DIR@",
                     "@Slicer_INSTALL_QTSCRIPTEDMODULES_BIN_DIR@",
                     "@Slicer_INSTALL_QTSCRIPTEDMODULES_LIB_DIR@"]

    # Strip leading "./" so os.path.join works correctly
    module_paths = []
    for rel in all_paths_rel:
        rel = rel.lstrip("./")
        p = os.path.join(install_prefix, rel)
        if os.path.isdir(p):
            module_paths.append(p)

    current_ld_library_path = os.environ.get('LD_LIBRARY_PATH', '')
    custom_paths_str = ":".join(module_paths) + ":@Slicer_DIR@/bin"
    if current_ld_library_path:
        new_ld_library_path = f"{custom_paths_str}:{current_ld_library_path}"
    else:
        new_ld_library_path = custom_paths_str

    # Build the base command
    cmd = [slicer_executable]
    for path in module_paths:
        cmd.extend(["--additional-module-path", path])

    return LaunchDescription([
        DeclareLaunchArgument(
            'slicer_args',
            default_value='',
            description='Additional arguments to pass to Slicer'
        ),

        ExecuteProcess(
            cmd=cmd,
            additional_env={'LD_LIBRARY_PATH': new_ld_library_path},
            shell=False,
            output='screen'
        )
    ])

