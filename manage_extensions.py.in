#!/usr/bin/env python3
import sys
import os
import json
import subprocess
import requests
import pathlib
import shutil
from PyQt5 import QtWidgets, QtCore, QtGui

# Constants
INDEX_URL = "https://api.github.com/repos/Slicer/ExtensionsIndex/contents"
RAW_URL_BASE = "https://raw.githubusercontent.com/Slicer/ExtensionsIndex/main/"

# Slicer_DIR is set by CMake during configuration
SLICER_DIR = "@Slicer_DIR@"

# Extension workspace root.  Sources, builds, and launch-time config all live
# under the package install prefix so the generated launcher can use one stable
# location without relying on CMake install targets from third-party extensions.
EXT_BASE = os.path.join("@CMAKE_INSTALL_PREFIX@", "@SlicerROS2_EXTENSIONS_INSTALL_DIR@")
EXT_SRC_BASE = os.path.join(EXT_BASE, "src")
EXT_BUILD_BASE = os.path.join(EXT_BASE, "build")
EXT_CONFIG_DIR = os.path.join("@CMAKE_INSTALL_PREFIX@", "@SlicerROS2_EXTENSIONS_CONFIG_DIR@")
EXT_RUNTIME_PATHS_FILE = os.path.join(EXT_CONFIG_DIR, "runtime_paths.json")

SLICER_REL_PATHS = [
    "@Slicer_INSTALL_BIN_DIR@",
    "@Slicer_INSTALL_LIB_DIR@",
    "@Slicer_INSTALL_QTLOADABLEMODULES_BIN_DIR@",
    "@Slicer_INSTALL_QTLOADABLEMODULES_LIB_DIR@",
    "@Slicer_INSTALL_QTLOADABLEMODULES_PYTHON_LIB_DIR@",
    "@Slicer_INSTALL_QTLOADABLEMODULES_SHARE_DIR@",
    "@Slicer_INSTALL_QTSCRIPTEDMODULES_BIN_DIR@",
    "@Slicer_INSTALL_QTSCRIPTEDMODULES_LIB_DIR@",
    "@Slicer_INSTALL_QTSCRIPTEDMODULES_PYTHON_LIB_DIR@",
    "@Slicer_INSTALL_QTSCRIPTEDMODULES_SHARE_DIR@",
]

def normalized_rel_paths():
    paths = []
    for rel in SLICER_REL_PATHS:
        rel = rel.lstrip("./")
        if rel and rel not in paths:
            paths.append(rel)
    return paths

def path_has_runtime_artifacts(path):
    if not os.path.isdir(path):
        return False
    try:
        entries = os.listdir(path)
    except OSError:
        return False
    for entry in entries:
        full_path = os.path.join(path, entry)
        if os.path.isdir(full_path) and entry in ("Resources", "Python"):
            return True
        if entry.endswith(".py") or entry.endswith(".dylib") or entry.endswith(".dll") or ".so" in entry:
            return True
    return False

def path_has_libraries(path):
    if not os.path.isdir(path):
        return False
    try:
        return any(
            entry.endswith(".dylib") or entry.endswith(".dll") or ".so" in entry
            for entry in os.listdir(path)
        )
    except OSError:
        return False

def append_unique(paths, path):
    if path and os.path.isdir(path) and path not in paths:
        paths.append(path)

def is_module_rel_path(rel):
    return "qt-loadable-modules" in rel or "qt-scripted-modules" in rel

def discover_runtime_paths(root):
    load_paths = []
    library_paths = []
    for rel in normalized_rel_paths():
        path = os.path.join(root, rel)
        if is_module_rel_path(rel) and path_has_runtime_artifacts(path):
            append_unique(load_paths, path)
        if path_has_libraries(path):
            append_unique(library_paths, path)
    return load_paths, library_paths

def extension_runtime_roots(name):
    build_dir = os.path.join(EXT_BUILD_BASE, name)
    roots = [
        build_dir,
        os.path.join(build_dir, "inner-build"),
        os.path.join(build_dir, f"{name}-build"),
    ]
    if os.path.isdir(build_dir):
        try:
            for entry in os.listdir(build_dir):
                path = os.path.join(build_dir, entry)
                if os.path.isdir(path) and entry.endswith("-build"):
                    append_unique(roots, path)
        except OSError:
            pass
    return roots

def discover_extension_runtime_paths(name):
    load_paths = []
    library_paths = []
    for root in extension_runtime_roots(name):
        candidate_load_paths, candidate_library_paths = discover_runtime_paths(root)
        for path in candidate_load_paths:
            append_unique(load_paths, path)
        for path in candidate_library_paths:
            append_unique(library_paths, path)
    return load_paths, library_paths

def read_runtime_registry():
    if not os.path.exists(EXT_RUNTIME_PATHS_FILE):
        return {}
    try:
        with open(EXT_RUNTIME_PATHS_FILE) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}

def write_runtime_registry(registry):
    os.makedirs(EXT_CONFIG_DIR, exist_ok=True)
    with open(EXT_RUNTIME_PATHS_FILE, "w") as f:
        json.dump(registry, f, indent=2, sort_keys=True)
        f.write("\n")

def update_runtime_registry_entry(name):
    build_dir = os.path.join(EXT_BUILD_BASE, name)
    source_dir = os.path.join(EXT_SRC_BASE, name)
    load_paths, library_paths = discover_extension_runtime_paths(name)
    if not load_paths:
        raise Exception(f"No Slicer module artifacts found in build tree for {name}")
    registry = read_runtime_registry()
    registry[name] = {
        "source_dir": source_dir,
        "build_dir": build_dir,
        "load_paths": load_paths,
        "library_paths": library_paths,
    }
    write_runtime_registry(registry)
    return registry[name]

def regenerate_runtime_registry():
    registry = {}
    if os.path.isdir(EXT_BUILD_BASE):
        for name in sorted(os.listdir(EXT_BUILD_BASE)):
            build_dir = os.path.join(EXT_BUILD_BASE, name)
            if not os.path.isdir(build_dir):
                continue
            load_paths, library_paths = discover_extension_runtime_paths(name)
            if load_paths:
                registry[name] = {
                    "source_dir": os.path.join(EXT_SRC_BASE, name),
                    "build_dir": build_dir,
                    "load_paths": load_paths,
                    "library_paths": library_paths,
                }
    write_runtime_registry(registry)
    return registry

class ExtensionWorker(QtCore.QThread):
    progress = QtCore.pyqtSignal(str)
    finished = QtCore.pyqtSignal(bool, str)

    def __init__(self, action, extension_name, metadata, slicer_dir, workspace_root):
        super().__init__()
        self.action = action
        self.extension_name = extension_name
        self.metadata = metadata
        self.slicer_dir = slicer_dir
        self.workspace_root = workspace_root

        # Determine number of cores for parallel builds
        import multiprocessing
        # Use half the cores to avoid memory swap issues during heavy Slicer compilation
        self.num_cores = max(1, multiprocessing.cpu_count() // 2)
        self.parallel_args = ["--parallel", str(self.num_cores)]

    def run(self):
        try:
            if self.action == "install":
                self.install_extension()
            elif self.action == "remove":
                self.remove_extension()
        except Exception as e:
            self.finished.emit(False, str(e))

    def run_command(self, cmd, cwd=None):
        self.progress.emit(f"Running: {' '.join(cmd)}")
        process = subprocess.Popen(
            cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
        )
        if process.stdout:
            for line in process.stdout:
                self.progress.emit(line.strip())
        process.wait()
        if process.returncode != 0:
            raise Exception(f"Command failed with exit code {process.returncode}")

    def install_extension(self):
        self.process_extension_recursive(self.extension_name, self.metadata)

    def process_extension_recursive(self, name, metadata):
        # 1. Handle Dependencies First
        deps = metadata.get('build_dependencies', [])
        dep_dirs = {}
        for dep_name in deps:
            self.progress.emit(f"Resolving dependency: {dep_name}")
            # Fetch dependency metadata
            dep_meta_url = f"{RAW_URL_BASE}{dep_name}.json"
            try:
                dep_resp = requests.get(dep_meta_url)
                dep_metadata = dep_resp.json()
                # Build dependency if not already installed
                self.process_extension_recursive(dep_name, dep_metadata)

                # Slicer extensions often need <DEP>_DIR pointing to the build or inner-build
                # We'll search for the Config file
                dep_build_dir = os.path.join(EXT_BUILD_BASE, dep_name)
                # Some extensions have an 'inner-build' (SuperBuild)
                inner_build = os.path.join(dep_build_dir, "inner-build")
                if os.path.exists(inner_build):
                    dep_dirs[f"{dep_name}_DIR"] = inner_build
                else:
                    dep_dirs[f"{dep_name}_DIR"] = dep_build_dir
            except Exception as e:
                self.progress.emit(f"Failed to resolve dependency {dep_name}: {e}")

        # 2. Build the extension itself
        ext_dir = os.path.join(EXT_SRC_BASE, name)
        build_dir = os.path.join(EXT_BUILD_BASE, name)

        pathlib.Path(ext_dir).parent.mkdir(parents=True, exist_ok=True)
        pathlib.Path(build_dir).mkdir(parents=True, exist_ok=True)

        # Clone or Pull
        scm_url = metadata['scm_url']
        if not os.path.exists(ext_dir):
            try:
                self.run_command(["git", "clone", scm_url, ext_dir])
            except Exception as e:
                if "https://github.com/" in scm_url:
                    ssh_url = scm_url.replace("https://github.com/", "git@github.com:").replace(".git", "") + ".git"
                    self.progress.emit(f"HTTPS clone failed, retrying with SSH: {ssh_url}")
                    self.run_command(["git", "clone", ssh_url, ext_dir])
                else:
                    raise e
        else:
            self.run_command(["git", "-C", ext_dir, "pull"])

        # Configure
        cmake_cmd = [
            "cmake",
            f"-S{ext_dir}",
            f"-B{build_dir}",
            f"-DSlicer_DIR={self.slicer_dir}",
            "-DCMAKE_BUILD_TYPE=Release"
        ]
        # Inject dependency paths
        for var, path in dep_dirs.items():
            cmake_cmd.append(f"-D{var}={path}")

        self.run_command(cmake_cmd)
        self.run_command(["cmake", "--build", build_dir] + self.parallel_args)

        entry = update_runtime_registry_entry(name)
        self.progress.emit(f"Saved runtime paths for {name}")
        self.progress.emit(f"  Module paths: {len(entry['load_paths'])}")
        self.progress.emit(f"  Library paths: {len(entry['library_paths'])}")

        if name == self.extension_name:
            self.finished.emit(True, build_dir)
        return build_dir

    def remove_extension(self):
        # Implementation for removal
        self.finished.emit(True, "Removed successfully")

class ExtensionManagerGUI(QtWidgets.QMainWindow):
    def __init__(self, slicer_dir, workspace_root):
        super().__init__()
        self.slicer_dir = slicer_dir
        self.workspace_root = workspace_root
        self.extensions_metadata = {}

        self.init_ui()
        self.fetch_extensions()

    def init_ui(self):
        self.setWindowTitle("Slicer Extension Manager for ROS2")
        self.resize(800, 600)

        central_widget = QtWidgets.QWidget()
        self.setCentralWidget(central_widget)
        layout = QtWidgets.QVBoxLayout(central_widget)

        # Info Header
        info_label = QtWidgets.QLabel(f"Slicer DIR: {self.slicer_dir}")
        info_label.setStyleSheet("font-weight: bold;")
        layout.addWidget(info_label)

        ext_label = QtWidgets.QLabel(f"Extension Root: {EXT_BASE}")
        layout.addWidget(ext_label)

        # Search
        search_layout = QtWidgets.QHBoxLayout()
        self.search_input = QtWidgets.QLineEdit()
        self.search_input.setPlaceholderText("Search extensions...")
        self.search_input.textChanged.connect(self.filter_extensions)
        search_layout.addWidget(QtWidgets.QLabel("Search:"))
        search_layout.addWidget(self.search_input)
        layout.addLayout(search_layout)

        # List
        self.list_widget = QtWidgets.QListWidget()
        layout.addWidget(self.list_widget)

        # Log/Output
        self.log_output = QtWidgets.QPlainTextEdit()
        self.log_output.setReadOnly(True)
        layout.addWidget(self.log_output)

        # Buttons
        btn_layout = QtWidgets.QHBoxLayout()
        self.install_btn = QtWidgets.QPushButton("Install Selected")
        self.install_btn.clicked.connect(self.start_install)
        self.remove_btn = QtWidgets.QPushButton("Remove Selected")
        self.remove_btn.clicked.connect(self.start_remove)
        self.quit_btn = QtWidgets.QPushButton("Quit")
        self.quit_btn.clicked.connect(self.close)
        btn_layout.addWidget(self.install_btn)
        btn_layout.addWidget(self.remove_btn)
        btn_layout.addWidget(self.quit_btn)
        layout.addLayout(btn_layout)

        # Keyboard shortcuts
        QtWidgets.QShortcut(QtGui.QKeySequence("Ctrl+Q"), self).activated.connect(self.close)
        QtWidgets.QShortcut(QtGui.QKeySequence("Ctrl+C"), self).activated.connect(self.close)

    def fetch_extensions(self):
        try:
            # Fallback strategy: GitHub API often hits rate limits.
            # We can scrape the HTML page for .json file names and construct raw URLs.
            self.log_output.appendPlainText("Fetching extension list from GitHub...")
            web_url = "https://github.com/Slicer/ExtensionsIndex/tree/main/"
            response = requests.get(web_url)

            import re
            # Match all .json files in the file list
            pattern = re.compile(r'[^"/]+\.json')
            files = sorted(list(set(pattern.findall(response.text))))

            if not files:
                # If scraping fails, maybe it's the API? Try one last time.
                response = requests.get(INDEX_URL)
                data = response.json()
                if isinstance(data, list):
                    for f in data:
                        if f['name'].endswith('.json'):
                            name = f['name'].replace('.json', '')
                            # Clean up potential scraping artifacts like '>'
                            name = name.lstrip('>')
                            self.extensions_metadata[name] = f['download_url']
                else:
                    raise Exception("Could not find any extensions. GitHub might be blocking requests.")
            else:
                for f in files:
                    name = f.replace('.json', '')
                    # Clean up potential scraping artifacts like '>'
                    name = name.lstrip('>')
                    # Construct the raw download URL manually
                    self.extensions_metadata[name] = f"{RAW_URL_BASE}{f}.json" if not f.endswith(".json") else f"{RAW_URL_BASE}{f}"

            self.log_output.appendPlainText(f"Found {len(self.extensions_metadata)} extensions.")
            self.filter_extensions()
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Error", f"Failed to fetch extensions: {e}")

    def filter_extensions(self):
        self.list_widget.clear()
        query = self.search_input.text().lower()

        runtime_registry = regenerate_runtime_registry()
        installed_names = sorted(runtime_registry.keys())

        all_names = sorted(self.extensions_metadata.keys())

        # Sort so installed items are on top
        installed_items = []
        other_items = []

        for name in all_names:
            if query in name.lower():
                item = QtWidgets.QListWidgetItem(name)
                if name in installed_names:
                    item.setForeground(QtGui.QColor("green"))
                    item.setText(f"{name} (Installed)")
                    installed_items.append(item)
                else:
                    other_items.append(item)

        for item in installed_items:
            self.list_widget.addItem(item)
        for item in other_items:
            self.list_widget.addItem(item)

    def start_install(self):
        current_item = self.list_widget.currentItem()
        if not current_item:
            return

        name = current_item.text().split(' (')[0]
        self.log_output.appendPlainText(f"Fetching metadata for {name}...")

        # Fetch full metadata
        metadata_url = self.extensions_metadata[name]
        try:
            meta_resp = requests.get(metadata_url)
            metadata = meta_resp.json()
        except:
             QtWidgets.QMessageBox.critical(self, "Error", "Failed to fetch extension metadata")
             return

        self.worker = ExtensionWorker("install", name, metadata, self.slicer_dir, self.workspace_root)
        self.worker.progress.connect(lambda msg: self.log_output.appendPlainText(msg))
        self.worker.finished.connect(self.on_finished)
        self.install_btn.setEnabled(False)
        self.worker.start()

    def start_remove(self):
        current_item = self.list_widget.currentItem()
        if not current_item:
            return

        name = current_item.text().split(' (')[0]

        reply = QtWidgets.QMessageBox.question(
            self, "Remove Extension",
            f"Remove source, build, and runtime config for {name}?",
            QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No
        )
        if reply != QtWidgets.QMessageBox.Yes:
            return

        try:
            runtime_registry = read_runtime_registry()
            if name in runtime_registry:
                del runtime_registry[name]
                write_runtime_registry(runtime_registry)

            ext_build_dir = os.path.join(EXT_BUILD_BASE, name)
            if os.path.isdir(ext_build_dir):
                shutil.rmtree(ext_build_dir)
                self.log_output.appendPlainText(f"Removed build dir: {ext_build_dir}")

            ext_src_dir = os.path.join(EXT_SRC_BASE, name)
            if os.path.isdir(ext_src_dir):
                shutil.rmtree(ext_src_dir)
                self.log_output.appendPlainText(f"Removed source dir: {ext_src_dir}")

            self.log_output.appendPlainText(f"Successfully removed {name}")
            self.filter_extensions()
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Error", f"Failed to remove extension: {e}")

    def on_finished(self, success, result):
        self.install_btn.setEnabled(True)
        if success:
            name = self.worker.extension_name
            self.log_output.appendPlainText(f"Successfully installed {name}")
            self.filter_extensions()
        else:
            QtWidgets.QMessageBox.critical(self, "Error", f"Operation failed: {result}")

if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGINT, signal.SIG_DFL)

    app = QtWidgets.QApplication(sys.argv)

    # workspace_root is 4 levels up from <prefix>/lib/slicer_ros2_module/manage_extensions.py
    # Extension sources are checked out at <workspace_root>/extensions/<name>
    _lib_dir = os.path.dirname(os.path.abspath(__file__))
    workspace_root = os.path.abspath(os.path.join(_lib_dir, "..", "..", "..", ".."))

    window = ExtensionManagerGUI(SLICER_DIR, workspace_root)
    window.show()
    sys.exit(app.exec_())
